# ==============================================================================
# NeoRAG Environment Configuration Template (Backend)
# Copy this file to backend/.env before launching.
# NEVER commit your actual API keys or secrets to version control.
# ==============================================================================

# Google Gemini API Key (Required for embeddings and live generation)
# Get your free key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Active Models
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Storage & Ephemeral Data Paths (Relative to backend/)
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=multimodal_rag_collection
SQLITE_DB_PATH=data/metadata.db
UPLOADS_DIRECTORY=data/uploads
PROCESSED_DIRECTORY=data/processed

# Title-Based Chunking Parameters
CHUNK_MAX_CHARACTERS=3000
CHUNK_NEW_AFTER_N_CHARS=2400
CHUNK_COMBINE_UNDER_N_CHARS=500

# Pipeline Feature Flags & Retrieval Defaults
ENABLE_MULTIMODAL_SUMMARY=true
ENABLE_QUERY_EXPANSION=true
ENABLE_RERANKING=true
RETRIEVAL_K=5
RERANK_TOP_N=10
FINAL_CONTEXT_K=5
DEFAULT_RRF_K=60
DEFAULT_VECTOR_WEIGHT=0.7
DEFAULT_BM25_WEIGHT=0.3

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security Settings
# Optional API Key: leave empty for open development mode, or set a secret to require X-API-Key header
API_KEY=
MAX_UPLOAD_SIZE_MB=25
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30
